# Local development: copy to the ignored .dev.vars file.
# Replace these placeholders before configuring your production domain/tools.
# content/business.json is the public business profile and takes domain priority.
SITE_URL="https://[YOUR DOMAIN]"
# Only the separate staging deployment sets this to staging.
SITE_ENV=production
GA_MEASUREMENT_ID="G-[YOUR GA4 ID]"
GTM_CONTAINER_ID="GTM-[YOUR CONTAINER ID]"
GOOGLE_SITE_VERIFICATION="[SEARCH CONSOLE VERIFICATION]"

# Optional private routing override. Otherwise delivery uses the public email
# supplied in content/business.json. There is no legacy inbox fallback.
# Owner-approved copies are configured in content/enquiries.json, not form fields.
ENQUIRY_TO=

# Optional alternative to FormSubmit; requires a verified sending domain.
RESEND_API_KEY=
ENQUIRY_FROM=

# Optional private Google Sheets connection. Both values stay server-side.
# Install integrations/google-sheets/Code.gs and deploy it before enabling.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=
